.DS_Store

# CLion files
.idea
cmake-build-*

# Python/PyCharm files
venv
__pycache__

# build directories
/build/

# CPM source cache (set in CMakeLists.txt; overridable via $CPM_SOURCE_CACHE)
/.cpm_cache/

# CMake-generated build artifacts (CMake configures src/ in-tree by default
# in some workflows; the actual build output lives under /build/, but cmake
# also drops these into the source tree). Never check them in.
**/CMakeFiles/
**/CTestTestfile.cmake
**/cmake_install.cmake
# Generated Makefiles in src/ (every Makefile under src/ is cmake-generated
# except the two hand-written tlsf ones, explicitly un-ignored below).
/src/**/Makefile
!/src/external/tlsf/examples/Makefile
!/src/external/tlsf/src/Makefile
/Makefile

*~
*.orig
# vim swap files
.*.sw?

# clangd
.cache/*

# VS Code files
.vscode/*
!.vscode/tasks.json
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/c_cpp_properties.json

node_modules/

# Benchmark results (generated, not tracked)
bench/results/

# Auto-generated followup / analysis docs
docs/BENCH_FOLLOWUP.md

# asdf/mise plugin scaffold (lives in its own repo: rjungemann/asdf-hypercollider)
asdf-hypercollider/

# Local Claude Code agent state
.claude/
