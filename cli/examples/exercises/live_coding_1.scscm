; live_coding_1.scscm — Exercise 1 solution: switch to pentatonic
;
; The melody is constrained to a five-note pentatonic scale (C D E G A).
; The pad and bass are dropped a fifth (G as root) for a darker mood.

(defsynth pad (freq 220 amp 0.15 gate 1)
  (var lfo  (* 3 (SinOsc.kr 0.1)))
  (var osc  (SinOsc.ar (+ freq lfo) 0))
  (var env  (EnvGen.kr (Env.asr 4 1 4) gate
                       (dict :doneAction 2)))
  (Out.ar 0 (* osc env amp 0.5)))

(defsynth bass (freq 110 amp 0.25 gate 1)
  (var osc (* (SinOsc.ar freq 0) 0.7))
  (var sub (* (SinOsc.ar (* freq 0.5) 0) 0.3))
  (var env (EnvGen.kr (Env.perc 0.05 1.5) gate
                      (dict :doneAction 2)))
  (Out.ar 0 (* (+ osc sub) env amp)))

(defsynth melody (freq 440 amp 0.2 gate 1)
  (var osc (SinOsc.ar freq 0))
  (var env (EnvGen.kr (Env.perc 0.02 0.6) gate
                      (dict :doneAction 2)))
  (Out.ar 0 (* osc env amp)))

; Pad on G2 (lowered a fifth from C3)
(Synth "pad" (dict :freq 196 :amp 0.15))

; Bass walks G-A-Bb-A
(. (pbind
     :instrument "bass"
     :midinote   (pseq (list 31 33 34 33) inf)
     :dur        2
     :amp        0.25)
   play)

; Melody picks from a G minor pentatonic scale (G Bb C D F)
(. (pbind
     :instrument "melody"
     :midinote   (prand (list 67 70 72 74 77) inf)
     :dur        (prand (list 0.5 1.0 1.5) inf)
     :amp        0.2)
   play)
