; live_coding_3.scscm — Exercise 3 solution: de-sync loop lengths
;
; The bass loops every 9 seconds (3 notes × 3 sec) instead of 8.
; The melody phrase length is randomized per note. The result is a
; patch that almost-but-not-quite repeats, evolving over time without
; ever locking into a single grid.

(defsynth pad (freq 220 amp 0.15 gate 1)
  (var lfo  (* 3 (SinOsc.kr 0.07)))            ; slower LFO
  (var osc  (SinOsc.ar (+ freq lfo) 0))
  (var env  (EnvGen.kr (Env.asr 4 1 4) gate
                       (dict :doneAction 2)))
  (Out.ar 0 (* osc env amp 0.5)))

(defsynth bass (freq 110 amp 0.25 gate 1)
  (var osc (* (SinOsc.ar freq 0) 0.7))
  (var sub (* (SinOsc.ar (* freq 0.5) 0) 0.3))
  (var env (EnvGen.kr (Env.perc 0.05 2.0) gate
                      (dict :doneAction 2)))
  (Out.ar 0 (* (+ osc sub) env amp)))

(defsynth melody (freq 440 amp 0.2 gate 1)
  (var osc (SinOsc.ar freq 0))
  (var env (EnvGen.kr (Env.perc 0.02 0.6) gate
                      (dict :doneAction 2)))
  (Out.ar 0 (* osc env amp)))

(Synth "pad" (dict :freq 220 :amp 0.15))

; Bass loops every 9 sec: 3 notes × 3 sec
(. (pbind
     :instrument "bass"
     :midinote   (pseq (list 36 41 38) inf)
     :dur        3
     :amp        0.25)
   play)

; Melody: random scale degrees, random durations.
; Total phrase length per note never repeats exactly.
(. (pbind
     :instrument "melody"
     :midinote   (prand (list 60 62 64 65 67 69 71 72) inf)
     :dur        (prand (list 0.4 0.6 0.8 1.0 1.3 1.7) inf)
     :amp        (prand (list 0.15 0.2 0.25) inf))
   play)
