; polyrhythm.scscm — 3-against-4 polyrhythm
;
; Voice A plays 3 notes per measure; voice B plays 4. They re-align
; every 12 beats (LCM(3, 4) = 12), creating a slowly-evolving feel.

(defsynth ping (freq 440 amp 0.2 gate 1)
  (var osc (SinOsc.ar freq 0))
  (var env (EnvGen.kr (Env.perc 0.005 0.2) gate
                      (dict :doneAction 2)))
  (Out.ar 0 (* osc env amp)))

; Voice A: 3 notes per 1.0 sec → 0.333 sec each
(. (pbind
     :instrument "ping"
     :midinote   (pseq (list 60 64 67) inf)
     :dur        (/ 1.0 3))
   play)

; Voice B: 4 notes per 1.0 sec → 0.25 sec each
(. (pbind
     :instrument "ping"
     :midinote   (pseq (list 72 71 69 67) inf)
     :dur        0.25)
   play)
