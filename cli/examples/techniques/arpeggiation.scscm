; arpeggiation.scscm — alternating up/down arpeggio
;
; Bounces between outer notes of a chord, like a finger-picked guitar.

(defsynth pluck (freq 440 amp 0.25 gate 1)
  (var osc (SinOsc.ar freq 0))
  (var env (EnvGen.kr (Env.perc 0.005 0.3) gate
                      (dict :doneAction 2)))
  (Out.ar 0 (* osc env amp)))

; Pattern: low E ↔ G (alternate), with occasional C up top
(. (pbind
     :instrument "pluck"
     :midinote   (pseq (list 60 67 64 67 60 67 64 72) inf)
     :dur        0.2
     :amp        0.25)
   play)
