; data_driven.scscm — a melody generated from a data series
;
; The series of integers (5 12 8 15 3 10 7 14) — for example monthly
; rainfall or temperature deltas — is mapped to MIDI notes 60-72.

(defsynth tone (freq 440 amp 0.25 gate 1)
  (var osc (SinOsc.ar freq 0))
  (var env (EnvGen.kr (Env.perc 0.01 0.4) gate
                      (dict :doneAction 2)))
  (Out.ar 0 (* osc env amp)))

; Map: data ∈ [3, 15] → midinote ∈ [60, 72]
; midinote = 60 + (data - 3) * (72 - 60) / (15 - 3)
;          = 60 + (data - 3)
(var data (list 5 12 8 15 3 10 7 14))

(. (pbind
     :instrument "tone"
     :midinote   (pseq (. data collect (fn (d) (+ 57 d))) inf)
     :dur        0.3
     :amp        0.25)
   play)
